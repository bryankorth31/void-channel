{
  "name": "voidtv-hq",
  "productName": "VOIDtv HQ",
  "version": "1.0.0",
  "description": "The control room for VOIDtv: shows, files, jobs, publishing and analytics, on this PC.",
  "main": "main.js",
  "author": "Church of American Strength & Hope",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "net.voidtv.hq",
    "productName": "VOIDtv HQ",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "build/icon.png"],
    "asar": true,
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VOIDtv HQ"
    }
  }
}
