  "voices": {
    "thaler": {
      "name": "Richard Thaler",
      "what": "Economist",
      "did": "Described the sunk cost trap in everyday spending in 1980 and won the 2017 Nobel prize for showing how people really decide."
    },
    "arkes": {
      "name": "Hal Arkes",
      "what": "Psychologist",
      "did": "With Catherine Blumer in 1985, showed that theatergoers who paid full price for season tickets went to more plays than those given a discount: the money already spent pulled them back."
    },
    "festinger": {
      "name": "Leon Festinger",
      "what": "Psychologist",
      "did": "Named cognitive dissonance in 1957, after studying a group whose prophecy of the end of the world failed and who then believed more strongly, not less."
    },
    "aronson": {
      "name": "Elliot Aronson",
      "what": "Psychologist",
      "did": "Showed in 1959 that people who went through a harsh initiation to join a dull group rated the group more highly: the cost made them defend the choice."
    },
    "cialdini": {
      "name": "Robert Cialdini",
      "what": "Psychologist",
      "did": "Trained as a salesman undercover to study persuasion, and named scarcity, \"only a few left\", as one of its main levers in Influence (1984)."
    },
    "przybylski": {
      "name": "Andrew Przybylski",
      "what": "Psychologist",
      "did": "Built the first scale to measure fear of missing out in 2013 and found it ties to heavier social media use and lower mood."
    }
  }
